programa
{
	
	funcao inicio()
	{
	inteiro numero 
	inteiro numero2 
	inteiro soma
		escreva("Forneça um número")
		leia(numero)
		escreva ("Forneça outro número")
		leia (numero2)
		soma = numero+numero2
		escreva(soma)
	}
}
